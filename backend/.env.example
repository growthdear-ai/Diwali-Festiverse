APP_ENV=development
# Production requires a random SECRET_KEY of at least 32 characters.
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./nazar.db

# SerpApi (live web / shopping searches and flight / stock / job monitoring)
SERPAPI_API_KEY=

# You.com (sourced search summaries and alert explanations)
YOU_API_KEY=

# Nexconn Platform Chat API
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
NEXCONN_API_HOST=https://api.sg-light-api.com
NEXCONN_BOT_USER_ID=nazar-bot
NEXCONN_BOT_NAME=Nazar
NEXCONN_WEBHOOK_SECRET=
NEXCONN_ALERT_MESSAGE_TYPE=NZ:AlertCard
NEXCONN_SEARCH_MESSAGE_TYPE=NZ:SearchCard
NEXCONN_AUTO_CREATE_GROUPS=false

# Local natural-language parsing and search-query refinement. Ollama needs no API key.
# For OpenAI, set LLM_PROVIDER=openai, LLM_BASE_URL=https://api.openai.com/v1
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
LLM_OLLAMA_MODEL=llama3.2:3b
LLM_API_KEY=

FRONTEND_URL=http://localhost:3000

# Monitoring / scheduler
SCHEDULER_ENABLED=true
WATCH_INTERVAL_MINUTES=30
MAX_ALERTS_PER_WATCH_PER_DAY=1
MORNING_BRIEF_ENABLED=true
MORNING_BRIEF_HOUR_UTC=1
BRIEF_LANGUAGE=en

# Rate limiting
RATE_LIMIT_PER_MINUTE=120

# Internal monitoring endpoints (X-Internal-Token header)
INTERNAL_API_TOKEN=

# Lyzr Enterprise Agent (structured verification of watch results)
LYZR_ENABLED=false
LYZR_API_KEY=
LYZR_AGENT_ID=
LYZR_AGENT_URL=

# BAND Collaboration (Scout→Verifier agent handoff in a BAND room)
BAND_ENABLED=false
BAND_SCOUT_AGENT_ID=
BAND_SCOUT_API_KEY=
BAND_VERIFIER_AGENT_ID=
BAND_VERIFIER_API_KEY=
BAND_ROOM_ID=
BAND_API_HOST=https://api.band.ai
BAND_WS_HOST=wss://api.band.ai
