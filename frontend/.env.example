# FastAPI backend origin (the client appends /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Nexconn App Key: a public client credential, passed to NCEngine.initialize in the browser.
# NEVER put NEXCONN_APP_SECRET here. It belongs only in backend/.env.
NEXT_PUBLIC_NEXCONN_APP_KEY=

# Must match backend NEXCONN_BOT_USER_ID and custom message types
NEXT_PUBLIC_NEXCONN_BOT_USER_ID=nazar-bot
NEXT_PUBLIC_NEXCONN_ALERT_MESSAGE_TYPE=NZ:AlertCard
NEXT_PUBLIC_NEXCONN_SEARCH_MESSAGE_TYPE=NZ:SearchCard
